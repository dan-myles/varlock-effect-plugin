{
  "name": "varlock-effect-plugin",
  "version": "0.1.0",
  "description": "Generate Effect Config modules from Varlock schemas",
  "type": "module",
  "homepage": "https://github.com/dan-myles/varlock-effect-plugin#readme",
  "bugs": "https://github.com/dan-myles/varlock-effect-plugin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-myles/varlock-effect-plugin.git"
  },
  "exports": {
    "./plugin": "./dist/plugin.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
