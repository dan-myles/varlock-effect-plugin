  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "effect": "^3.0.0",
    "varlock": "^1.18.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^25.3.2",
    "effect": "^3.22.1",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "varlock": "^1.18.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "bun@1.3.11"
}
